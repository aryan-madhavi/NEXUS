      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "nexus_influxdb_flux"
          },
          "query": "from(bucket: \"nexus_telemetry\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r[\"_measurement\"] == \"nexus_telem\")\n  |> filter(fn: (r) => r[\"_field\"] == \"temp\")\n  |> filter(fn: (r) => r[\"dev\"] =~ /^${dev:regex}$/)\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)\n  |> yield(name: \"temp\")",
