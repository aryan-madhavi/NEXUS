# NEXUS Ground Station — Environment Configuration Template
# Phase 5.3B.1: InfluxDB 2.x Time-Series Persistence Engine
# Phase 5.3B.2: Eclipse Mosquitto MQTT Broker Integration
#
# Instructions:
#   1. Copy this file to .env:
#        cp .env.example .env
#   2. Replace placeholder secrets with strong, random credentials.
#   3. The real .env file is excluded from Git via .gitignore.
#      DO NOT COMMIT THE ACTUAL .env FILE!

# ==============================================================================
# InfluxDB Container Provisioning Settings
# ==============================================================================

# Pinned InfluxDB 2.x image release (avoid using 'latest')
INFLUXDB_VERSION=2.7.11

# Local host port for InfluxDB (bound strictly to 127.0.0.1)
INFLUXDB_PORT=8086

# InfluxDB Initial Organization & Target Bucket
# Must match InfluxDBConfig defaults in ground_station/persistence/influxdb_writer.py
INFLUXDB_INIT_ORG=nexus
INFLUXDB_INIT_BUCKET=nexus_telemetry

# Data Retention Period (0 = infinite retention; e.g., 30d, 90d, 1y)
INFLUXDB_INIT_RETENTION=0

# InfluxDB Initial Administrator Credentials (used during first container setup)
# CHANGE THESE VALUES BEFORE STARTING SERVICES IN PRODUCTION!
INFLUXDB_INIT_USERNAME=nexus_admin
INFLUXDB_INIT_PASSWORD=nexus_admin_password_change_me

# InfluxDB Initial Admin / Operator API Token
# Used by the InfluxDB CLI, Grafana, and the Ground Station persistence writer
INFLUXDB_INIT_ADMIN_TOKEN=nexus_secret_admin_token_change_me

# ==============================================================================
# Ground Station Host Persistence Writer Configuration
# ==============================================================================

# Server endpoint URL accessed by ground_station persistence writer
INFLUXDB_URL=http://127.0.0.1:8086

# Target organization and bucket
INFLUXDB_ORG=nexus
INFLUXDB_BUCKET=nexus_telemetry

# API authentication token (matches INFLUXDB_INIT_ADMIN_TOKEN)
INFLUXDB_TOKEN=nexus_secret_admin_token_change_me

# Persistence queue and batch tuning
INFLUXDB_TIMEOUT_MS=3000
INFLUXDB_BATCH_SIZE=50
INFLUXDB_FLUSH_INTERVAL_SEC=1.0
INFLUXDB_MAX_QUEUE_SIZE=1000
INFLUXDB_MAX_RETRIES=3
INFLUXDB_RETRY_BASE_DELAY_SEC=0.2
INFLUXDB_RETRY_MAX_DELAY_SEC=2.0
INFLUXDB_MEASUREMENT_PREFIX=nexus
INFLUXDB_USE_SINGLE_MEASUREMENT=false

# ==============================================================================
# MQTT Broker Container Provisioning Settings
# ==============================================================================

# Pinned Mosquitto image release (avoid using 'latest')
MOSQUITTO_VERSION=2.1.2

# Local host port for Mosquitto (bound strictly to 127.0.0.1 by default)
MQTT_PORT=1883

# ==============================================================================
# Ground Station Host MQTT Transport Configuration
# ==============================================================================

# Broker host and port accessed by Ground Station host process
MQTT_HOST=127.0.0.1
MQTT_CLIENT_ID=nexus_ground_station
MQTT_KEEPALIVE_SEC=60

# Optional authentication credentials (leave empty if anonymous access is enabled in broker config)
MQTT_USERNAME=
MQTT_PASSWORD=

# Telemetry subscription topic filter and parsing pattern
MQTT_TOPIC_SUBSCRIPTION=nexus/+/telemetry
MQTT_TOPIC_REGEX=^nexus/(?P<device_id>[^/]+)/telemetry$

# ==============================================================================
# Grafana Container Provisioning Settings
# ==============================================================================

# Pinned Grafana image release (avoid using 'latest')
GRAFANA_VERSION=11.5.0

# Local host port for Grafana (bound strictly to 127.0.0.1)
GRAFANA_PORT=3000

# Initial Grafana Administrator Credentials
# CHANGE THESE VALUES BEFORE STARTING SERVICES IN PRODUCTION!
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=nexus_grafana_password_change_me

# Anonymous access policy (disabled by default for operational security)
# Set to 'false' to require authentication for all dashboard and data endpoints.
GRAFANA_ANONYMOUS_ENABLED=false
GRAFANA_ANONYMOUS_ORG_ROLE=Viewer


